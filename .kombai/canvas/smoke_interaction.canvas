      "html": "\n<div class=\"main-container relative w-full min-h-screen bg-[#0a0a0a] text-[#f4f0e6] font-['Space_Grotesk'] overflow-x-hidden\" data-kid=\"0\">\n    \n    <svg class=\"hidden\" data-kid=\"1\">\n        <filter id=\"grainy\" data-kid=\"2\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.65\" numOctaves=\"3\" stitchTiles=\"stitch\" data-kid=\"3\"></feTurbulence>\n            <feComposite operator=\"in\" in2=\"SourceGraphic\" data-kid=\"4\"></feComposite>\n        </filter>\n        <filter id=\"distort\" data-kid=\"5\">\n            <feTurbulence type=\"turbulence\" baseFrequency=\"0.01\" numOctaves=\"2\" result=\"noise\" seed=\"1\" data-kid=\"6\"></feTurbulence>\n            <feDisplacementMap in=\"SourceGraphic\" in2=\"noise\" scale=\"20\" data-kid=\"7\"></feDisplacementMap>\n        </filter>\n    </svg>\n\n    \n    <main class=\"relative z-10 w-full\" data-kid=\"8\">\n        \n        <section class=\"relative min-h-screen flex items-center justify-center p-10\" data-kid=\"9\">\n            <div class=\"relative w-full max-w-6xl h-[80vh] flex items-center justify-center\" data-kid=\"10\">\n                \n                \n                <div class=\"project-card absolute top-10 left-[5%] w-72 md:w-80 h-96 bg-[#111] border border-[#f4f0e6]/20 p-8 flex flex-col justify-between transform -rotate-6 z-10 shadow-2xl\" data-kid=\"11\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] text-[#d4ff00] font-bold\" data-kid=\"12\">Project 01 / AR-24</span>\n                    <h3 class=\"text-4xl font-black leading-none font-['Syne']\" data-kid=\"13\">SYNTH<br data-kid=\"14\">VOICE</h3>\n                    <div class=\"grow my-6 border-y border-[#f4f0e6]/5 py-4 overflow-hidden\" data-kid=\"15\">\n                        <img src=\"https://images.unsplash.com/photo-1578662996442-48f60103fc96?auto=format&w=600&q=80&fit=crop\" alt=\"Abstract texture\" class=\"w-full h-full object-cover grayscale brightness-50 contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"16\">\n                    </div>\n                    <p class=\"text-xs text-[#f4f0e6]/50 leading-relaxed italic\" data-kid=\"17\">Neural synthesis of localized dialect variants for global communication platforms.</p>\n                </div>\n\n                <div class=\"project-card absolute bottom-20 right-[8%] w-64 md:w-72 h-[450px] bg-[#111] border border-[#f4f0e6]/20 p-8 flex flex-col justify-between transform rotate-3 z-20 shadow-2xl\" data-kid=\"18\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] text-[#d4ff00] font-bold\" data-kid=\"19\">Project 02 / XT-09</span>\n                    <h3 class=\"text-4xl font-black leading-none font-['Syne']\" data-kid=\"20\">KINETIC<br data-kid=\"21\">VOID</h3>\n                    <div class=\"grow my-6 border-y border-[#f4f0e6]/5 py-4 overflow-hidden\" data-kid=\"22\">\n                        <img src=\"https://images.unsplash.com/photo-1552332271-440e9f146492?auto=format&w=600&q=80&fit=crop\" alt=\"Abstract texture\" class=\"w-full h-full object-cover grayscale brightness-50 contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n                    </div>\n                    <p class=\"text-xs text-[#f4f0e6]/50 leading-relaxed italic\" data-kid=\"24\">Responsive architectural skin reacting to high-frequency urban soundscapes.</p>\n                </div>\n\n                <div class=\"project-card absolute top-1/4 right-[25%] w-56 md:w-64 h-80 bg-[#111] border border-[#f4f0e6]/20 p-6 flex flex-col justify-between transform -rotate-2 z-0 opacity-80 scale-95 shadow-xl\" data-kid=\"25\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] text-[#d4ff00] font-bold\" data-kid=\"26\">Archive / BK-02</span>\n                    <h3 class=\"text-3xl font-black leading-none font-['Syne']\" data-kid=\"27\">MONO<br data-kid=\"28\">GRID</h3>\n                    <p class=\"text-[10px] text-[#f4f0e6]/40 mt-4\" data-kid=\"29\">Legacy research into grid-based modular typography for low-resolution displays.</p>\n                </div>\n\n                <div class=\"project-card absolute top-[60%] left-[15%] w-48 h-64 bg-[#111] border border-[#f4f0e6]/10 p-6 flex flex-col justify-between transform rotate-12 z-5 opacity-60 scale-90 blur-[1px]\" data-kid=\"30\">\n                    <span class=\"text-[8px] uppercase tracking-[0.3em] text-[#f4f0e6]/50\" data-kid=\"31\">Fragment / 00</span>\n                    <h3 class=\"text-2xl font-black leading-none font-['Syne'] opacity-30\" data-kid=\"32\">NOISE<br data-kid=\"33\">CORE</h3>\n                </div>\n\n                \n                <div class=\"relative z-30 text-center pointer-events-none select-none\" data-kid=\"34\">\n                    <h1 class=\"text-[clamp(6rem,15vw,18rem)] font-black tracking-tighter leading-none font-['Syne'] mix-blend-difference outline-text\" data-kid=\"35\">\n                        CLEARING\n                    </h1>\n                    <p class=\"text-sm tracking-[0.5em] uppercase opacity-40 mt-4\" data-kid=\"36\">Editorial Grain / Vol 03</p>\n                </div>\n\n                \n                <div class=\"absolute top-[20%] left-[40%] bg-[#d4ff00] text-[#0a0a0a] px-4 py-2 text-[12px] font-black uppercase tracking-widest rotate-12 z-40 shadow-[6px_6px_0_#f4f0e6]\" data-kid=\"37\">REVEALED</div>\n            </div>\n        </section>\n\n        \n        <section class=\"max-w-6xl mx-auto px-10 py-32 border-t-2 border-[#f4f0e6]/20\" data-kid=\"38\">\n            <div class=\"flex flex-col md:flex-row gap-20\" data-kid=\"39\">\n                <div class=\"md:w-1/3\" data-kid=\"40\">\n                    <h2 class=\"text-xs uppercase tracking-[0.4em] text-[#d4ff00] font-black sticky top-32\" data-kid=\"41\">01 / Services</h2>\n                    <p class=\"text-sm text-[#f4f0e6]/40 mt-6 leading-relaxed\" data-kid=\"42\">Pushing the boundaries of digital interaction through sophisticated AI automation and generative systems.</p>\n                </div>\n                <div class=\"md:w-2/3\" data-kid=\"43\">\n                    <div class=\"border-y-2 border-[#f4f0e6]/20\" data-kid=\"44\">\n                        \n                        <div class=\"accordion-item group py-12 cursor-pointer border-b-2 border-[#f4f0e6]/20 last:border-0\" data-kid=\"45\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"46\">\n                                <div class=\"flex items-center gap-8\" data-kid=\"47\">\n                                    <span class=\"font-mono text-xs opacity-30 shrink-0\" data-kid=\"48\">001</span>\n                                    <h3 class=\"text-4xl md:text-6xl lg:text-7xl font-black tracking-tighter font-['Syne'] transition-all group-hover:pl-4 uppercase\" data-kid=\"49\">AUTOMATIONS</h3>\n                                </div>\n                                <div class=\"w-12 h-12 flex items-center justify-center border border-[#f4f0e6]/20 rounded-full group-hover:bg-[#d4ff00] group-hover:border-[#d4ff00] group-hover:text-[#0a0a0a] transition-colors\" data-kid=\"50\">\n                                    <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"51\"></i>\n                                </div>\n                            </div>\n                            <div class=\"accordion-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out opacity-0 group-hover:max-h-60 group-hover:opacity-100 group-hover:mt-8\" data-kid=\"52\">\n                                <div class=\"pl-20 max-w-xl\" data-kid=\"53\">\n                                    <p class=\"text-xl text-[#f4f0e6]/60 leading-relaxed font-light\" data-kid=\"54\">Custom industrial automation stacks using RLHF and neural-symbolic reasoning for precision manufacturing.</p>\n                                    <div class=\"flex gap-4 mt-6\" data-kid=\"55\">\n                                        <span class=\"px-2 py-1 border border-[#f4f0e6]/10 text-[10px] uppercase\" data-kid=\"56\">TensorFlow</span>\n                                        <span class=\"px-2 py-1 border border-[#f4f0e6]/10 text-[10px] uppercase\" data-kid=\"57\">Cuda</span>\n                                        <span class=\"px-2 py-1 border border-[#f4f0e6]/10 text-[10px] uppercase\" data-kid=\"58\">RPA</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"accordion-item group py-12 cursor-pointer border-b border-[#f4f0e6]/10 last:border-0\" data-kid=\"59\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"60\">\n                                <div class=\"flex items-center gap-8\" data-kid=\"61\">\n                                    <span class=\"font-mono text-xs opacity-30 shrink-0\" data-kid=\"62\">002</span>\n                                    <h3 class=\"text-4xl md:text-6xl lg:text-7xl font-black tracking-tighter font-['Syne'] transition-all group-hover:pl-4 uppercase\" data-kid=\"63\">GENERATIVE AI</h3>\n                                </div>\n                                <div class=\"w-12 h-12 flex items-center justify-center border border-[#f4f0e6]/20 rounded-full group-hover:bg-[#d4ff00] group-hover:border-[#d4ff00] group-hover:text-[#0a0a0a] transition-colors\" data-kid=\"64\">\n                                    <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"65\"></i>\n                                </div>\n                            </div>\n                            <div class=\"accordion-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out opacity-0 group-hover:max-h-60 group-hover:opacity-100 group-hover:mt-8\" data-kid=\"66\">\n                                <div class=\"pl-20 max-w-xl\" data-kid=\"67\">\n                                    <p class=\"text-xl text-[#f4f0e6]/60 leading-relaxed font-light\" data-kid=\"68\">Strategic deployment of diffusion models and bespoke LLMs for semantic content generation and dynamic brand assets.</p>\n                                    <div class=\"flex gap-4 mt-6\" data-kid=\"69\">\n                                        <span class=\"px-2 py-1 border border-[#f4f0e6]/10 text-[10px] uppercase\" data-kid=\"70\">Stable Diffusion</span>\n                                        <span class=\"px-2 py-1 border border-[#f4f0e6]/10 text-[10px] uppercase\" data-kid=\"71\">Llama 3</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"accordion-item group py-12 cursor-pointer border-b border-[#f4f0e6]/10 last:border-0\" data-kid=\"72\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"73\">\n                                <div class=\"flex items-center gap-8\" data-kid=\"74\">\n                                    <span class=\"font-mono text-xs opacity-30 shrink-0\" data-kid=\"75\">003</span>\n                                    <h3 class=\"text-4xl md:text-6xl lg:text-7xl font-black tracking-tighter font-['Syne'] transition-all group-hover:pl-4 uppercase\" data-kid=\"76\">UX RESEARCH</h3>\n                                </div>\n                                <div class=\"w-12 h-12 flex items-center justify-center border border-[#f4f0e6]/20 rounded-full group-hover:bg-[#d4ff00] group-hover:border-[#d4ff00] group-hover:text-[#0a0a0a] transition-colors\" data-kid=\"77\">\n                                    <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"78\"></i>\n                                </div>\n                            </div>\n                            <div class=\"accordion-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out opacity-0 group-hover:max-h-60 group-hover:opacity-100 group-hover:mt-8\" data-kid=\"79\">\n                                <div class=\"pl-20 max-w-xl\" data-kid=\"80\">\n                                    <p class=\"text-xl text-[#f4f0e6]/60 leading-relaxed font-light\" data-kid=\"81\">Deep-dive interaction studies using eye-tracking and biometric feedback for safety-critical interfaces.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 border-t border-[#f4f0e6]/10 overflow-hidden\" data-kid=\"82\">\n            <div class=\"max-w-6xl mx-auto px-10 mb-20\" data-kid=\"83\">\n                <h2 class=\"text-xs uppercase tracking-[0.4em] text-[#d4ff00] font-black\" data-kid=\"84\">02 / Experience Path</h2>\n            </div>\n            \n            <div class=\"timeline-container relative cursor-grab active:cursor-grabbing\" data-kid=\"85\">\n                \n                <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-[#f4f0e6]/10 -translate-y-1/2\" data-kid=\"86\"></div>\n                \n                <div class=\"flex gap-20 px-10 md:px-40 w-max transition-transform duration-100 ease-out\" id=\"timeline-scroll\" data-kid=\"87\">\n                    \n                    <div class=\"timeline-item flex-shrink-0 w-80 relative\" data-kid=\"88\">\n                        <div class=\"w-6 h-6 rounded-full bg-[#d4ff00] absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 ring-8 ring-[#d4ff00]/20 z-10 shadow-[6px_6px_0_#f4f0e6]\" data-kid=\"89\"></div>\n                        <div class=\"pt-20\" data-kid=\"90\">\n                            <span class=\"text-xs font-mono opacity-40 block mb-2\" data-kid=\"91\">2023 — PRESENT</span>\n                            <h4 class=\"text-3xl font-black tracking-tighter font-['Syne'] mb-4\" data-kid=\"92\">LEAD AI ARCHITECT</h4>\n                            <p class=\"text-sm text-[#f4f0e6]/50 leading-relaxed\" data-kid=\"93\">Directing the AI division at Xylo Systems. Developing high-fidelity synthetic data generators for urban planning simulations.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-item flex-shrink-0 w-80 relative\" data-kid=\"94\">\n                        <div class=\"w-6 h-6 rounded-full bg-[#f4f0e6] absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 ring-4 ring-[#f4f0e6]/20 z-10 shadow-[6px_6px_0_#d4ff00]\" data-kid=\"95\"></div>\n                        <div class=\"pt-20\" data-kid=\"96\">\n                            <span class=\"text-xs font-mono opacity-40 block mb-2\" data-kid=\"97\">2021 — 2023</span>\n                            <h4 class=\"text-3xl font-black tracking-tighter font-['Syne'] mb-4\" data-kid=\"98\">SR. INTERACTION DESIGNER</h4>\n                            <p class=\"text-sm text-[#f4f0e6]/50 leading-relaxed\" data-kid=\"99\">Consulting for Aerospace Corp on next-gen cockpit displays for commercial sub-orbital transport.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-item flex-shrink-0 w-80 relative\" data-kid=\"100\">\n                        <div class=\"w-6 h-6 rounded-full bg-[#f4f0e6] absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 ring-4 ring-[#f4f0e6]/20 z-10 shadow-[6px_6px_0_#d4ff00]\" data-kid=\"101\"></div>\n                        <div class=\"pt-20\" data-kid=\"102\">\n                            <span class=\"text-xs font-mono opacity-40 block mb-2\" data-kid=\"103\">2019 — 2021</span>\n                            <h4 class=\"text-3xl font-black tracking-tighter font-['Syne'] mb-4\" data-kid=\"104\">CREATIVE DEVELOPER</h4>\n                            <p class=\"text-sm text-[#f4f0e6]/50 leading-relaxed\" data-kid=\"105\">Built immersive web-based data visualizations for environmental agencies at Studio Grain.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-item flex-shrink-0 w-80 relative\" data-kid=\"106\">\n                        <div class=\"w-6 h-6 rounded-full bg-[#f4f0e6] absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 ring-4 ring-[#f4f0e6]/20 z-10 shadow-[6px_6px_0_#d4ff00]\" data-kid=\"107\"></div>\n                        <div class=\"pt-20\" data-kid=\"108\">\n                            <span class=\"text-xs font-mono opacity-40 block mb-2\" data-kid=\"109\">2017 — 2019</span>\n                            <h4 class=\"text-3xl font-black tracking-tighter font-['Syne'] mb-4\" data-kid=\"110\">PRODUCT INTERN</h4>\n                            <p class=\"text-sm text-[#f4f0e6]/50 leading-relaxed\" data-kid=\"111\">Contributing to open-source UI libraries used in blockchain explorers.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"mt-20 flex justify-center\" data-kid=\"112\">\n                <div class=\"flex items-center gap-4 text-[#d4ff00]/60 text-[10px] uppercase tracking-[0.4em]\" data-kid=\"113\">\n                    <i class=\"ti ti-arrows-move text-lg animate-pulse\" data-kid=\"114\"></i>\n                    <span data-kid=\"115\">Wipe to discover</span>\n                </div>\n            </div>\n        </section>\n\n        \n        <footer class=\"p-10 border-t border-[#f4f0e6]/10 flex flex-col md:flex-row justify-between items-end min-h-[40vh] gap-10\" data-kid=\"116\">\n            <div data-kid=\"117\">\n                <h2 class=\"text-[clamp(4rem,12vw,9rem)] font-black font-['Syne'] tracking-tighter leading-[0.8]\" data-kid=\"118\">GRAIN<br data-kid=\"119\">FOLIO</h2>\n                <p class=\"mt-8 text-xs opacity-40 uppercase tracking-widest\" data-kid=\"120\">© 2024 / Digital Editorial Studio</p>\n            </div>\n            <div class=\"text-right\" data-kid=\"121\">\n                <a href=\"#\" class=\"block text-4xl font-black font-['Syne'] hover:text-[#d4ff00] transition-colors\" data-kid=\"122\">HELLO@GRAIN.XYZ</a>\n                <div class=\"flex gap-6 justify-end mt-4 opacity-40 uppercase text-[10px] tracking-widest\" data-kid=\"123\">\n                    <a href=\"#\" data-kid=\"124\">Twitter</a>\n                    <a href=\"#\" data-kid=\"125\">Are.na</a>\n                    <a href=\"#\" data-kid=\"126\">Layers</a>\n                </div>\n            </div>\n        </footer>\n    </main>\n\n    \n    <div id=\"fog-overlay\" class=\"fixed inset-0 z-[100] pointer-events-none overflow-hidden\" data-kid=\"127\">\n        \n        <div class=\"absolute inset-0 bg-[#d4ff00]\" data-kid=\"128\"></div>\n        \n        \n        <div class=\"absolute inset-0 opacity-30 bg-[url('https://images.unsplash.com/photo-1744033416342-614bfac570fe?auto=format&w=1200&q=80')] bg-cover mix-blend-multiply grain-anim\" data-kid=\"129\"></div>\n        \n        \n        <div class=\"absolute inset-0 halftone-dots opacity-50\" data-kid=\"130\"></div>\n        \n        \n        <div class=\"absolute inset-0 grain-noise opacity-15\" data-kid=\"131\"></div>\n    </div>\n\n    \n    <style data-kid=\"132\">\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=Syne:wght@400;700;800&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --reveal-radius: 350px;\n            --mouse-x: 50%;\n            --mouse-y: 50%;\n        }\n\n        .outline-text {\n            -webkit-text-stroke: 1.5px rgba(244, 240, 230, 0.4);\n            color: transparent;\n        }\n\n        .halftone-dots {\n            background-image: radial-gradient(circle, #000 1.2px, transparent 1.2px);\n            background-size: 5px 5px;\n        }\n\n        .grain-noise {\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n        }\n\n        #fog-overlay {\n            /* Multi-layered mask for turbulent feel */\n            mask-image: \n                radial-gradient(circle calc(var(--reveal-radius) * 0.8) at var(--mouse-x) var(--mouse-y), transparent 0%, transparent 40%, rgba(0,0,0,0.3) 70%, black 100%),\n                radial-gradient(circle var(--reveal-radius) at var(--mouse-x) var(--mouse-y), transparent 0%, black 100%);\n            -webkit-mask-image: \n                radial-gradient(circle calc(var(--reveal-radius) * 0.8) at var(--mouse-x) var(--mouse-y), transparent 0%, transparent 40%, rgba(0,0,0,0.3) 70%, black 100%),\n                radial-gradient(circle var(--reveal-radius) at var(--mouse-x) var(--mouse-y), transparent 0%, black 100%);\n            mask-composite: intersect;\n            -webkit-mask-composite: destination-in;\n        }\n\n        /* Animation for grain shift */\n        @keyframes grain-shift {\n            0% { transform: translate(0, 0); }\n            10% { transform: translate(-5%, -5%); }\n            20% { transform: translate(-10%, 5%); }\n            30% { transform: translate(5%, -10%); }\n            40% { transform: translate(-5%, 15%); }\n            50% { transform: translate(-10%, 5%); }\n            60% { transform: translate(15%, 0); }\n            70% { transform: translate(0, 10%); }\n            80% { transform: translate(-15%, 0); }\n            90% { transform: translate(10%, 5%); }\n            100% { transform: translate(5%, 0); }\n        }\n\n        .grain-anim {\n            width: 120%;\n            height: 120%;\n            top: -10%;\n            left: -10%;\n            animation: grain-shift 8s steps(10) infinite;\n        }\n\n        /* Removed CSS transitions to avoid conflict with GSAP */\n        .project-card:hover {\n            z-index: 100;\n        }\n\n        /* Timeline scrolling */\n        .timeline-container {\n            overflow-x: auto;\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n        .timeline-container::-webkit-scrollbar {\n            display: none;\n        }\n    </style>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"133\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"134\"></script>\n    <script data-kid=\"135\">\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Mask follows cursor with smoothing\n        const root = document.documentElement;\n        let mouseX = window.innerWidth / 2;\n        let mouseY = window.innerHeight / 2;\n        let currentX = mouseX;\n        let currentY = mouseY;\n        let velX = 0;\n        let velY = 0;\n\n        window.addEventListener('mousemove', (e) => {\n            velX = (e.clientX - mouseX) * 0.5;\n            velY = (e.clientY - mouseY) * 0.5;\n            mouseX = e.clientX;\n            mouseY = e.clientY;\n        });\n\n        function animateMask() {\n            // Smooth lerp for the mask movement\n            currentX += (mouseX - currentX) * 0.12;\n            currentY += (mouseY - currentY) * 0.12;\n\n            root.style.setProperty('--mouse-x', `${currentX}px`);\n            root.style.setProperty('--mouse-y', `${currentY}px`);\n            \n            // Subtle \"wind\" effect on the fog overlay itself\n            gsap.to('.grain-anim', {\n                x: velX * 2,\n                y: velY * 2,\n                duration: 0.5,\n                ease: \"power2.out\"\n            });\n\n            requestAnimationFrame(animateMask);\n        }\n        animateMask();\n\n        // Reveal animations for content as they appear\n        gsap.utils.toArray('.project-card').forEach((card, i) => {\n            const initialRotate = i % 2 === 0 ? -6 : 3;\n            gsap.from(card, {\n                scrollTrigger: {\n                    trigger: card,\n                    start: \"top 90%\",\n                },\n                y: 100,\n                opacity: 0,\n                rotate: i % 2 === 0 ? -10 : 10,\n                duration: 1.5,\n                ease: \"power4.out\"\n            });\n            \n            card.addEventListener('mouseenter', () => {\n                gsap.to(card, {\n                    y: -20,\n                    rotate: 0,\n                    scale: 1.05,\n                    duration: 0.6,\n                    ease: \"power2.out\",\n                    overwrite: true\n                });\n            });\n            \n            card.addEventListener('mouseleave', () => {\n                gsap.to(card, {\n                    y: 0,\n                    rotate: initialRotate,\n                    scale: 1,\n                    duration: 0.6,\n                    ease: \"power2.inOut\",\n                    overwrite: true\n                });\n            });\n        });\n\n        // Horizontal timeline interaction (Simple drag or just scrolling)\n        const timeline = document.getElementById('timeline-scroll');\n        const container = document.querySelector('.timeline-container');\n        \n        let isDown = false;\n        let startX;\n        let scrollLeft;\n\n        container.addEventListener('mousedown', (e) => {\n            isDown = true;\n            startX = e.pageX - container.offsetLeft;\n            scrollLeft = container.scrollLeft;\n        });\n        container.addEventListener('mouseleave', () => isDown = false);\n        container.addEventListener('mouseup', () => isDown = false);\n        container.addEventListener('mousemove', (e) => {\n            if (!isDown) return;\n            e.preventDefault();\n            const x = e.pageX - container.offsetLeft;\n            const walk = (x - startX) * 2;\n            container.scrollLeft = scrollLeft - walk;\n        });\n\n        // Add a parallax effect to the clearing text\n        gsap.to('.outline-text', {\n            scrollTrigger: {\n                trigger: '.outline-text',\n                start: \"top bottom\",\n                end: \"bottom top\",\n                scrub: 1\n            },\n            y: -100,\n            scale: 1.1\n        });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-06-12T11:55:50.042496+00:00",

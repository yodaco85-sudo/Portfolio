      "html": "\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@800&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-primary: #f4f0e6;\n    --text-primary: #0a0a0a;\n    --accent-primary: #d4ff00;\n    --accent-secondary: #ff3d00;\n    --muted: #5c5c5c;\n  }\n\n  body {\n    background-color: var(--bg-primary);\n    color: var(--text-primary);\n    font-family: 'IBM+Plex+Mono', monospace;\n    cursor: none;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-syne { font-family: 'Syne', sans-serif; }\n  .font-mono { font-family: 'IBM Plex Mono', monospace; }\n\n  .brutal-border { border: 4px solid var(--text-primary); }\n  .brutal-shadow { box-shadow: 8px 8px 0px var(--text-primary); }\n  .brutal-shadow-lg { box-shadow: 16px 16px 0px var(--text-primary); }\n\n  .marquee-pill {\n    background: var(--accent-primary);\n    border: 3px solid var(--text-primary);\n    border-radius: 9999px;\n    padding: 0.5rem 2.5rem;\n    transform: rotate(-1.5deg);\n    display: inline-block;\n    overflow: hidden;\n    white-space: nowrap;\n    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  }\n  .marquee-pill:hover {\n    transform: rotate(0deg) scale(1.05);\n  }\n\n  /* Custom Cursor */\n  #custom-cursor {\n    position: fixed;\n    width: 48px;\n    height: 48px;\n    pointer-events: none;\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    mix-blend-mode: difference;\n    transform: translate(-50%, -50%);\n  }\n\n  /* Project Strip Styles */\n  .project-strip-container {\n    overflow: hidden;\n    padding: 4rem 0;\n    background: var(--text-primary);\n    color: var(--bg-primary);\n  }\n\n  .project-track {\n    display: flex;\n    gap: 4rem;\n    padding-left: 4rem;\n  }\n\n  .project-card {\n    flex: 0 0 450px;\n    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);\n    cursor: pointer;\n  }\n\n  .duotone-container {\n    background-color: var(--accent-primary);\n    border: 4px solid var(--bg-primary);\n    overflow: hidden;\n    aspect-ratio: 16/10;\n    margin-bottom: 1.5rem;\n    position: relative;\n  }\n\n  .duotone-img {\n    filter: grayscale(100%) contrast(1.2) brightness(0.8);\n    mix-blend-mode: multiply;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: all 0.6s ease;\n  }\n\n  .project-card:hover .duotone-img {\n    filter: none;\n    mix-blend-mode: normal;\n    transform: scale(1.05);\n  }\n\n  /* Skill Stickers */\n  .sticker {\n    background: white;\n    border: 3px solid var(--text-primary);\n    padding: 0.6rem 1.2rem;\n    font-weight: 700;\n    font-size: 1.1rem;\n    text-transform: uppercase;\n    transition: all 0.2s ease;\n    cursor: default;\n  }\n  .sticker:hover {\n    background: var(--accent-primary);\n    transform: scale(1.15) rotate(0deg) !important;\n    z-index: 20;\n  }\n\n  canvas#smokeCanvas {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  section {\n    position: relative;\n    z-index: 10;\n  }\n\n  .bio-text span {\n    background: var(--accent-primary);\n    padding: 0 4px;\n  }\n</style>\n\n\n<div id=\"custom-cursor\" data-kid=\"2\">\n  <i class=\"ti ti-crosshair text-4xl text-[var(--accent-primary)]\" data-kid=\"3\"></i>\n</div>\n\n\n<canvas id=\"smokeCanvas\" data-kid=\"4\"></canvas>\n\n\n<main class=\"relative z-10\" data-kid=\"5\">\n  \n  \n  <section class=\"min-h-screen flex flex-col justify-center items-center text-center px-6 pt-20 overflow-hidden\" data-kid=\"6\">\n    <div class=\"relative inline-block w-full max-w-6xl\" data-kid=\"7\">\n      <h1 class=\"font-syne text-[clamp(3.5rem,14vw,11rem)] leading-[0.85] uppercase tracking-tight select-none\" data-kid=\"8\">\n        <span class=\"block\" data-kid=\"9\">YOANN</span>\n        <span class=\"block\" data-kid=\"10\">DACOSTA</span>\n      </h1>\n      \n      \n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bright-explosion.svg\" class=\"absolute -top-8 -right-4 w-20 h-20 opacity-80 animate-pulse pointer-events-none\" style=\"filter: invert(0);\" data-kid=\"11\">\n    </div>\n\n    <div class=\"mt-12\" data-kid=\"12\">\n      <div class=\"marquee-pill brutal-shadow relative\" data-kid=\"13\">\n        <div class=\"flex gap-8 px-4 py-1 animate-[marquee_10s_linear_infinite]\" data-kid=\"14\">\n          <span class=\"font-mono font-bold text-xl uppercase tracking-wider whitespace-nowrap\" data-kid=\"15\">PRODUCT BUILDER / PRODUCT BUILDER / PRODUCT BUILDER / PRODUCT BUILDER</span>\n        </div>\n      </div>\n      <style data-kid=\"16\">\n        @keyframes marquee {\n          0% { transform: translateX(0); }\n          100% { transform: translateX(-25%); }\n        }\n      </style>\n    </div>\n\n    <div class=\"mt-24 font-mono text-sm uppercase tracking-widest animate-bounce\" data-kid=\"17\">\n      ( SCROLL TO EXPLORE )\n    </div>\n  </section>\n\n  \n  <section class=\"min-h-screen py-32 px-8 max-w-[1440px] mx-auto\" data-kid=\"18\">\n    <div class=\"flex items-center gap-4 mb-16\" data-kid=\"19\">\n      <div class=\"h-1 w-20 bg-black\" data-kid=\"20\"></div>\n      <h2 class=\"font-syne text-7xl uppercase tracking-tighter\" data-kid=\"21\">/ THE LAB</h2>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-16\" data-kid=\"22\">\n      \n      <div class=\"md:col-span-7 bg-white brutal-border brutal-shadow-lg p-12 relative group\" data-kid=\"23\">\n        <div class=\"absolute -top-8 -left-8 bg-black text-[var(--accent-primary)] font-bold px-6 py-2 brutal-border\" data-kid=\"24\">\n          ROOT@SYSTEM:~#\n        </div>\n        \n        <p class=\"font-mono text-3xl leading-relaxed bio-text\" data-kid=\"25\">\n          I ARCHITECT <span data-kid=\"26\">INTERACTIVE REALMS</span> WHERE CODE MEETS CHAOS. SPECIALIZING IN <span data-kid=\"27\">GENERATIVE SYSTEMS</span>, BRUTALIST AESTHETICS, AND LIQUID INTERFACES. \n        </p>\n        \n        <div class=\"mt-12 pt-8 border-t-2 border-black/10 flex items-center justify-between\" data-kid=\"28\">\n          <div class=\"flex gap-4\" data-kid=\"29\">\n             <i class=\"ti ti-brand-github text-3xl\" data-kid=\"30\"></i>\n             <i class=\"ti ti-brand-twitter text-3xl\" data-kid=\"31\"></i>\n             <i class=\"ti ti-brand-linkedin text-3xl\" data-kid=\"32\"></i>\n          </div>\n          <button class=\"font-bold border-b-4 border-black hover:text-[var(--accent-secondary)] transition-colors\" data-kid=\"33\">READ MANIFESTO.PDF</button>\n        </div>\n      </div>\n\n      \n      <div class=\"md:col-span-5 relative flex flex-wrap gap-4 content-start pt-10\" data-kid=\"34\">\n        <div class=\"sticker\" style=\"transform: rotate(-4deg);\" data-kid=\"35\">WEBGL</div>\n        <div class=\"sticker\" style=\"transform: rotate(3deg); background: var(--accent-primary);\" data-kid=\"36\">TYPESCRIPT</div>\n        <div class=\"sticker\" style=\"transform: rotate(-7deg);\" data-kid=\"37\">GSAP</div>\n        <div class=\"sticker\" style=\"transform: rotate(5deg);\" data-kid=\"38\">THREE.JS</div>\n        <div class=\"sticker\" style=\"transform: rotate(-2deg); background: var(--accent-secondary); color: white;\" data-kid=\"39\">CREATIVE</div>\n        <div class=\"sticker\" style=\"transform: rotate(8deg);\" data-kid=\"40\">REACT</div>\n        <div class=\"sticker\" style=\"transform: rotate(-5deg);\" data-kid=\"41\">P5.JS</div>\n        <div class=\"sticker\" style=\"transform: rotate(3deg); background: var(--accent-primary);\" data-kid=\"42\">UI DESIGN</div>\n        <div class=\"sticker\" style=\"transform: rotate(-3deg);\" data-kid=\"43\">RUST</div>\n        \n        <div class=\"mt-12 w-full p-8 border-2 border-dashed border-black/30 rounded-xl\" data-kid=\"44\">\n           <h4 class=\"font-bold mb-4 uppercase\" data-kid=\"45\">Current Status:</h4>\n           <div class=\"flex items-center gap-2\" data-kid=\"46\">\n             <span class=\"w-3 h-3 bg-green-500 rounded-full animate-pulse\" data-kid=\"47\"></span>\n             <span class=\"text-sm opacity-70\" data-kid=\"48\">AVAILABLE FOR HIGH-IMPACT COLLABORATIONS</span>\n           </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"project-strip-section bg-black\" data-kid=\"49\">\n    <div class=\"project-strip-container\" data-kid=\"50\">\n      <div class=\"px-8 mb-12 flex flex-col md:flex-row justify-between items-end gap-6\" data-kid=\"51\">\n        <h2 class=\"font-syne text-7xl uppercase tracking-tighter text-[var(--accent-primary)]\" data-kid=\"52\">PROJECTS</h2>\n        <p class=\"font-mono text-sm max-w-sm text-right opacity-60\" data-kid=\"53\">A SELECTION OF RECENT COMMERCIAL EXPERIMENTS AND PERSONAL DEEP-DIVES INTO TYPOGRAPHIC MOTION.</p>\n      </div>\n\n      <div class=\"project-track\" id=\"projectTrack\" data-kid=\"54\">\n        \n        <div class=\"project-card\" data-kid=\"55\">\n          <div class=\"duotone-container flex items-center justify-center bg-zinc-800 group-hover:bg-[var(--accent-primary)] transition-colors duration-500\" data-kid=\"56\">\n             <span class=\"font-syne text-8xl opacity-30 select-none group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"57\">01</span>\n          </div>\n          <div class=\"flex justify-between items-center px-2\" data-kid=\"58\">\n            <h3 class=\"font-syne text-2xl uppercase tracking-tighter\" data-kid=\"59\">NEON_VOID</h3>\n            <span class=\"font-mono text-xs opacity-50\" data-kid=\"60\">2024 / ART DIRECTION</span>\n          </div>\n        </div>\n        \n        <div class=\"project-card\" data-kid=\"61\">\n          <div class=\"duotone-container flex items-center justify-center bg-zinc-700 group-hover:bg-[var(--accent-primary)] transition-colors duration-500\" data-kid=\"62\">\n             <span class=\"font-syne text-8xl opacity-30 select-none group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"63\">02</span>\n          </div>\n          <div class=\"flex justify-between items-center px-2\" data-kid=\"64\">\n            <h3 class=\"font-syne text-2xl uppercase tracking-tighter\" data-kid=\"65\">LIQUID_TYPE</h3>\n            <span class=\"font-mono text-xs opacity-50\" data-kid=\"66\">2023 / WEBGL</span>\n          </div>\n        </div>\n        \n        <div class=\"project-card\" data-kid=\"67\">\n          <div class=\"duotone-container flex items-center justify-center bg-zinc-900 group-hover:bg-[var(--accent-primary)] transition-colors duration-500\" data-kid=\"68\">\n             <span class=\"font-syne text-8xl opacity-30 select-none group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"69\">03</span>\n          </div>\n          <div class=\"flex justify-between items-center px-2\" data-kid=\"70\">\n            <h3 class=\"font-syne text-2xl uppercase tracking-tighter\" data-kid=\"71\">BAUHAUS_2.0</h3>\n            <span class=\"font-mono text-xs opacity-50\" data-kid=\"72\">2024 / INTERFACE</span>\n          </div>\n        </div>\n        \n        <div class=\"project-card\" data-kid=\"73\">\n          <div class=\"duotone-container flex items-center justify-center bg-zinc-800 group-hover:bg-[var(--accent-primary)] transition-colors duration-500\" data-kid=\"74\">\n             <span class=\"font-syne text-8xl opacity-30 select-none group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"75\">04</span>\n          </div>\n          <div class=\"flex justify-between items-center px-2\" data-kid=\"76\">\n            <h3 class=\"font-syne text-2xl uppercase tracking-tighter\" data-kid=\"77\">KINETIC_CORE</h3>\n            <span class=\"font-mono text-xs opacity-50\" data-kid=\"78\">2023 / MOTION</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-8 border-t-4 border-black text-center font-mono uppercase tracking-widest\" data-kid=\"79\">\n    <p class=\"mb-8\" data-kid=\"80\">DESIGNED IN CHAOS / BUILT WITH PRECISION</p>\n    <div class=\"text-xs opacity-40\" data-kid=\"81\">© 2024 YOANN DACOSTA — ALL RIGHTS RESERVED</div>\n  </footer>\n\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"82\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"83\"></script>\n<script type=\"module\" data-kid=\"84\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  // Smooth Scroll\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // Custom Cursor\n  const cursor = document.getElementById('custom-cursor');\n  window.addEventListener('mousemove', (e) => {\n    gsap.to(cursor, {\n      x: e.clientX,\n      y: e.clientY,\n      duration: 0.1,\n      ease: \"power2.out\"\n    });\n  });\n\n  // ASCII Smoke Canvas Implementation\n  const canvas = document.getElementById('smokeCanvas');\n  const ctx = canvas.getContext('2d');\n  let particles = [];\n  const particleCount = 400;\n  const chars = ['~', '*', '+', '&'];\n  const mouse = { x: -1000, y: -1000 };\n\n  window.addEventListener('mousemove', (e) => {\n    mouse.x = e.clientX;\n    mouse.y = e.clientY;\n  });\n\n  function resize() {\n    canvas.width = window.innerWidth;\n    canvas.height = window.innerHeight;\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  class Particle {\n    constructor() {\n      this.init();\n    }\n\n    init() {\n      this.x = Math.random() * canvas.width;\n      this.y = Math.random() * canvas.height;\n      this.char = chars[Math.floor(Math.random() * chars.length)];\n      this.color = Math.random() > 0.3 ? '#5c5c5c' : '#d4ff00';\n      this.size = Math.random() * 14 + 10;\n      this.vx = (Math.random() - 0.5) * 0.5;\n      this.vy = (Math.random() - 0.5) * 0.5;\n      this.baseVx = this.vx;\n      this.baseVy = this.vy;\n      this.fleeing = false;\n    }\n\n    update() {\n      // Normal drift\n      this.x += this.vx;\n      this.y += this.vy;\n\n      // Mouse repulsion\n      const dx = this.x - mouse.x;\n      const dy = this.y - mouse.y;\n      const dist = Math.sqrt(dx * dx + dy * dy);\n      const repulsionRadius = 150;\n\n      if (dist < repulsionRadius) {\n        const angle = Math.atan2(dy, dx);\n        const power = (repulsionRadius - dist) / repulsionRadius;\n        // Spring flee logic\n        this.vx += Math.cos(angle) * power * 2;\n        this.vy += Math.sin(angle) * power * 2;\n        this.fleeing = true;\n      } else {\n        // Soft return to base drift\n        this.vx += (this.baseVx - this.vx) * 0.02;\n        this.vy += (this.baseVy - this.vy) * 0.02;\n        this.fleeing = false;\n      }\n\n      // Physics damping\n      this.vx *= 0.92;\n      this.vy *= 0.92;\n\n      // Wrap around with margin\n      if (this.x < -20) this.x = canvas.width + 20;\n      if (this.x > canvas.width + 20) this.x = -20;\n      if (this.y < -20) this.y = canvas.height + 20;\n      if (this.y > canvas.height + 20) this.y = -20;\n    }\n\n    draw() {\n      ctx.fillStyle = this.color;\n      ctx.font = `${this.size}px \"IBM Plex Mono\"`;\n      ctx.fillText(this.char, this.x, this.y);\n    }\n  }\n\n  function initParticles() {\n    particles = [];\n    for (let i = 0; i < particleCount; i++) {\n      particles.push(new Particle());\n    }\n  }\n  initParticles();\n\n  function animate() {\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    particles.forEach(p => {\n      p.update();\n      p.draw();\n    });\n    requestAnimationFrame(animate);\n  }\n  animate();\n\n  // Project Strip Horizontal Animation\n  const track = document.getElementById('projectTrack');\n  const trackWidth = track.scrollWidth;\n  \n  gsap.to(track, {\n    x: () => -(trackWidth / 2),\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \".project-strip-container\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    }\n  });\n\n  // Fade in elements on scroll\n  gsap.utils.toArray('.brutal-border').forEach(el => {\n    gsap.from(el, {\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 90%\",\n      }\n    });\n  });\n\n  // Interaction: Smoke clears from project strip area\n  const strip = document.querySelector('.project-strip-section');\n  strip.addEventListener('mouseenter', () => {\n    gsap.to(canvas, { opacity: 0.05, duration: 0.8, ease: \"power2.inOut\" });\n  });\n  strip.addEventListener('mouseleave', () => {\n    gsap.to(canvas, { opacity: 1, duration: 0.8, ease: \"power2.inOut\" });\n  });\n\n</script>\n",
